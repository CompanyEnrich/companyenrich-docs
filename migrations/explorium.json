{
  "$comment": "Explorium AgentSource to CompanyEnrich V2 migration mapping. Source of truth for the tables in docs/migrate-from-explorium*.mdx. Validated against openapi/v2.json by scripts/sync-migrations.mjs. Explorium names come from its public developer documentation as checked on checkedAt.",
  "version": 1,
  "checkedAt": "2026-11-16",
  "vendor": {
    "key": "explorium",
    "name": "Explorium",
    "searchLabel": "filter",
    "slug": "explorium",
    "api": "AgentSource v1 and v2",
    "baseUrl": "https://api.explorium.ai",
    "docs": "https://developers.explorium.ai",
    "auth": "API_KEY header",
    "mcp": ["https://mcp.explorium.ai", "https://mcp-v2.explorium.ai/mcp"],
    "shutdown": {
      "date": "2026-12-02",
      "notice": "https://www.explorium.ai/blog/news-and-updates/farewell-from-explorium-with-gratitude/",
      "summary": "Explorium says AgentSource will be discontinued on December 2, 2026."
    }
  },
  "companyEnrich": {
    "api": "v2",
    "baseUrl": "https://api.companyenrich.com",
    "spec": "https://docs.companyenrich.com/openapi/v2.json",
    "auth": "Authorization: Bearer YOUR_API_TOKEN",
    "apiKeyEnv": "COMPANYENRICH_API_KEY",
    "mcp": "https://mcp.companyenrich.com/mcp",
    "guides": {
      "overview": "https://docs.companyenrich.com/docs/migrate-from-explorium",
      "fieldMapping": "https://docs.companyenrich.com/docs/migrate-from-explorium-field-mapping",
      "search": "https://docs.companyenrich.com/docs/migrate-from-explorium-search",
      "agent": "https://docs.companyenrich.com/docs/migrate-from-explorium-agent"
    },
    "sdks": {
      "python": "https://docs.companyenrich.com/docs/python-sdk",
      "javascript": "https://docs.companyenrich.com/docs/javascript-typescript-sdk",
      "ruby": "https://docs.companyenrich.com/docs/ruby-sdk",
      "php": "https://docs.companyenrich.com/docs/php-sdk"
    }
  },
  "fidelity": {
    "same": "Same meaning and format.",
    "renamed": "Same meaning and values under a different name or label.",
    "transformed": "Same information in a different format, casing, or structure. Convert it in code.",
    "lossy": "Related but not equivalent. Values can differ, so check the fields your code depends on.",
    "none": "No CompanyEnrich equivalent."
  },
  "endpoints": [
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/match", "POST /v1/businesses/match"],
      "exploriumInput": ["domain", "url"],
      "companyEnrich": "GET /v2/companies/enrich",
      "status": "partial",
      "inputs": { "businesses_to_match[].domain": ["domain"], "businesses_to_match[].url": ["domain"] },
      "note": "There is no separate match step. The enrich call returns the company record, or `404` when there is none. Send the host only, such as `stripe.com`. Store the domain, or the CompanyEnrich `id`, instead of `business_id`."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/match", "POST /v1/businesses/match"],
      "exploriumInput": ["name", "linkedin_url"],
      "companyEnrich": "POST /v2/companies/enrich",
      "status": "partial",
      "inputs": { "businesses_to_match[].name": ["name"], "businesses_to_match[].linkedin_url": ["linkedinUrl"] },
      "note": "Every property you send must match. When several companies match, the highest-ranked one is returned. No match returns `404` and is not charged."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/firmographics/enrich", "POST /v1/businesses/firmographics/enrich"],
      "companyEnrich": "GET /v2/companies/enrich",
      "status": "mapped",
      "inputs": { "business_id": ["domain"], "business_ids": ["domain"], "businesses_to_match": ["domain"] },
      "note": "Firmographics are the base company record. One request per domain."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/firmographics/job", "POST /v1/businesses/firmographics/bulk_enrich"],
      "companyEnrich": "POST /v2/companies/enrich/batch",
      "status": "partial",
      "inputs": { "business_ids": ["domains[]"], "businesses_to_match": ["domains[]"] },
      "note": "Up to 50 domains per request, returned in request order with a `status` of `found`, `not-found`, `invalid-domain`, or `pending`. For up to 10,000 domains in the background, use `POST /v2/companies/enrich/bulk`."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/technographics/enrich", "POST /v2/businesses/webstack/enrich", "POST /v1/businesses/technographics/enrich", "POST /v1/businesses/webstack/enrich"],
      "companyEnrich": "GET /v2/companies/enrich",
      "status": "partial",
      "inputs": { "business_id": ["domain"], "business_ids": ["domain"], "businesses_to_match": ["domain"] },
      "note": "Request `expand=technologies`. It returns a flat list of technologies, with no categories and no website spend or traffic fields."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/workforce_trends/enrich", "POST /v1/businesses/workforce_trends/enrich"],
      "companyEnrich": "GET /v2/companies/workforce",
      "status": "partial",
      "inputs": { "business_id": ["domain"], "business_ids": ["domain"], "businesses_to_match": ["domain"] },
      "note": "Returns headcount by department and its history, as counts instead of percentages. To get the current breakdown with the company record, request `expand=workforce` on enrichment."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/funding_and_acquisition/enrich", "POST /v1/businesses/funding_and_acquisition/enrich"],
      "companyEnrich": "GET /v2/companies/enrich",
      "status": "partial",
      "inputs": { "business_id": ["domain"], "business_ids": ["domain"], "businesses_to_match": ["domain"] },
      "note": "Request `expand=financial` for funding rounds, total funding, and the stock symbol. Acquisitions, advisors, and IPO details have no equivalent."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/lookalikes/enrich", "POST /v1/businesses/lookalikes/enrich"],
      "companyEnrich": "POST /v2/companies/search",
      "status": "partial",
      "inputs": { "business_id": ["lookalike.domains"], "business_ids": ["lookalike.domains"], "businesses_to_match": ["lookalike.domains"] },
      "note": "Send a `lookalike` query with 1 to 10 seed domains, plus optional filters. Results are company records ranked by similarity, without a `similarity_score`."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses", "POST /v1/businesses"],
      "companyEnrich": "POST /v2/companies/search",
      "status": "partial",
      "inputs": { "filters": ["filter"], "page_size": ["pageSize"], "next_cursor": ["cursor"] },
      "drop": { "mode": "results are always full records." },
      "note": "Rewrite each filter. See [Translate search filters](/docs/migrate-from-explorium-search). Results are full company records, so no enrichment call is needed afterwards for firmographic fields. Numbered `page` requests have no equivalent; page with the cursor."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/stats", "POST /v1/businesses/stats"],
      "companyEnrich": "POST /v2/companies/search/count",
      "status": "partial",
      "note": "Free. Returns the total only, with no breakdown by industry, revenue, size, or region. Run one count per segment you need."
    },
    {
      "group": "company",
      "explorium": ["GET /v2/autocomplete", "GET /v1/businesses/autocomplete"],
      "companyEnrich": "GET /v2/companies/autocomplete",
      "status": "partial",
      "note": "Free. Company autocomplete suggests companies for a domain prefix. For filter values, use technology, keyword, or position autocomplete, the industry list, or the geo endpoints."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/financial_indicators/enrich", "POST /v1/businesses/financial_indicators/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No public-company financial metrics such as EBITDA or ratios. `expand=financial` returns the stock symbol and exchange."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/company_hierarchies/enrich", "POST /v1/businesses/company_hierarchies/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No parent or subsidiary data."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/linkedin_posts/enrich", "POST /v1/businesses/linkedin_posts/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No social posts."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/website_changes/enrich", "POST /v1/businesses/website_changes/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No website change history. Every record has an `updatedAt` timestamp."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/company_website_keywords/enrich", "POST /v1/businesses/company_website_keywords/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No full-text search of website pages. The `keywords` search filter and expansion use keywords that describe the company, not page text."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/company_ratings_by_employees/enrich", "POST /v1/businesses/company_ratings_by_employees/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No employee ratings."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/bombora_intent/enrich", "POST /v1/businesses/bombora_intent/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No intent data."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/pc_strategy_10k/enrich", "POST /v2/businesses/pc_competitive_landscape_10k/enrich", "POST /v2/businesses/pc_business_challenges_10k/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No analysis of annual reports. The same applies to the v1 routes."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/research/enrich", "POST /v2/businesses/research/job"],
      "companyEnrich": null,
      "status": "none",
      "note": "No custom AI research endpoint. Semantic search finds companies from a description, and the MCP server lets your own agent combine CompanyEnrich data with other tools."
    },
    {
      "group": "company",
      "explorium": ["POST /v2/businesses/events", "POST /v2/businesses/events/enrollments", "POST /v1/businesses/events"],
      "companyEnrich": null,
      "status": "none",
      "note": "No event feed, enrollments, or webhooks. To watch for changes, re-enrich the companies you track on a schedule and compare `updatedAt`, headcount, or funding."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/match", "POST /v1/prospects/match"],
      "exploriumInput": ["email"],
      "companyEnrich": "POST /v2/people/enrich",
      "status": "partial",
      "inputs": { "prospects_to_match[].email": ["email"] },
      "note": "Work emails only. The API resolves the company from the email domain, then matches the person. The person is the response body. No match returns `404` and is not charged."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/match", "POST /v1/prospects/match"],
      "exploriumInput": ["full_name", "company_name", "business_id"],
      "companyEnrich": "POST /v2/people/search",
      "status": "partial",
      "inputs": { "prospects_to_match[].full_name": ["filter.query"], "prospects_to_match[].company_name": ["filter.domain"], "prospects_to_match[].business_id": ["filter.domain"] },
      "note": "Search by name at the company's domain. It returns matching people without a confidence score, so pick the person in your code."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/match", "POST /v1/prospects/match"],
      "exploriumInput": ["linkedin", "phone_number"],
      "companyEnrich": null,
      "status": "none",
      "note": "No person lookup by LinkedIn URL or phone number."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects", "POST /v1/prospects"],
      "companyEnrich": "POST /v2/people/search",
      "status": "partial",
      "inputs": { "filters": ["filter", "company"], "page_size": ["pageSize"], "next_cursor": ["cursor"] },
      "drop": { "mode": "results are always full records." },
      "note": "Rewrite person conditions as `filter` and employer conditions as a `company` query. See [Translate search filters](/docs/migrate-from-explorium-search). Numbered `page` requests have no equivalent; page with the cursor."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/stats", "POST /v1/prospects/stats"],
      "companyEnrich": "POST /v2/people/search/count",
      "status": "partial",
      "note": "Free. Returns the total only, with no breakdown by department or region."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/profiles/enrich", "POST /v1/prospects/profiles/enrich"],
      "companyEnrich": "GET /v2/people/{personId}",
      "status": "partial",
      "inputs": { "prospect_id": ["personId"], "prospect_ids": ["personId"] },
      "note": "Takes a CompanyEnrich person ID from search or email enrichment. Explorium prospect IDs do not carry over."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/contact_information/enrich", "POST /v1/prospects/contacts_information/enrich"],
      "companyEnrich": "GET /v2/people/{personId}/email",
      "status": "partial",
      "inputs": { "prospect_id": ["personId"], "prospect_ids": ["personId"] },
      "note": "Work email only, with a `status` and `certainty`. No phone numbers, personal emails, or hashed emails. Costs 10 credits only when it finds an email your account has not accessed before."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/linkedin_posts/enrich", "POST /v1/prospects/linkedin_posts/enrich"],
      "companyEnrich": null,
      "status": "none",
      "note": "No social posts."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/events", "POST /v2/prospects/events/enrollments", "POST /v1/prospects/events"],
      "companyEnrich": null,
      "status": "none",
      "note": "No event feed. To find recent job changes, search with `currentPositionStartDate` or `currentCompanyStartDate`."
    },
    {
      "group": "people",
      "explorium": ["POST /v2/prospects/research/enrich", "POST /v2/prospects/research/job"],
      "companyEnrich": null,
      "status": "none",
      "note": "No custom AI research endpoint."
    },
    {
      "group": "supporting",
      "explorium": ["POST /v2/<enrichment>/job", "GET /v2/jobs/status/{job_id}", "POST /v1/<enrichment>/bulk_enrich"],
      "companyEnrich": "POST /v2/companies/enrich/bulk",
      "status": "partial",
      "note": "Background jobs exist for company enrichment by domain, up to 10,000 per job, and for exporting search results. Poll the batch, then download JSON, NDJSON, or CSV. See [Bulk jobs and exports](/docs/bulk-jobs-and-exports)."
    },
    {
      "group": "supporting",
      "explorium": ["GET /v2/credits", "GET /v1/credits"],
      "companyEnrich": "GET /v2/me",
      "status": "partial",
      "note": "Free. Returns your credit totals and plan capabilities. See [Account fields](/docs/migrate-from-explorium-field-mapping#account-fields). Each paid response also carries `x-credit-cost` and `x-credit-remaining` headers."
    },
    {
      "group": "supporting",
      "explorium": ["POST /v2/webhooks", "POST /v1/webhooks"],
      "companyEnrich": null,
      "status": "none",
      "note": "No webhooks."
    },
    {
      "group": "supporting",
      "explorium": ["POST /v2/async/entity-id-datasets/upload"],
      "companyEnrich": null,
      "status": "none",
      "note": "No uploaded ID datasets. Send domains directly to batch or bulk enrichment."
    }
  ],
  "mcp": [
    { "explorium": "match-business", "ce": ["enrich_company", "enrich_company_by_properties"], "note": "Returns the full record in one step, by domain or by name or social profile." },
    { "explorium": "enrich-business", "ce": ["enrich_company", "get_company_workforce"], "note": "The company record includes technologies, keywords, and funding. For headcount by department, set `includeWorkforce` or use `get_company_workforce`." },
    { "explorium": "fetch-businesses", "ce": ["search_companies"], "note": "Takes filters or a plain-language description." },
    { "explorium": "fetch-businesses-statistics", "ce": null, "note": "No statistics tool. Your agent can call the free count endpoint through the API." },
    { "explorium": "fetch-businesses-events", "ce": null, "note": "No events." },
    { "explorium": "match-prospects", "ce": ["lookup_person_by_email", "search_people"], "note": "By work email, or by name and company." },
    { "explorium": "fetch-prospects", "ce": ["search_people"], "note": "Filters by seniority, department, title, country, and employer." },
    { "explorium": "fetch-prospects-statistics", "ce": null, "note": "No statistics tool." },
    { "explorium": "fetch-prospects-events", "ce": null, "note": "No events." },
    { "explorium": "enrich-prospects", "ce": ["get_person_by_id", "enrich_person_email"], "note": "Profile and work email. No phone numbers." },
    { "explorium": "autocomplete", "ce": null, "note": "Not needed. `search_companies` and `search_people` accept plain values and descriptions." },
    { "explorium": null, "ce": ["find_similar_companies"], "note": "Lookalikes from 1 to 10 seed domains. Explorium offered this as an enrichment rather than a tool." },
    { "explorium": null, "ce": ["get_current_user"], "note": "Free. Checks your credit balance." }
  ],
  "fields": {
    "company": [
      { "group": "Identity", "explorium": "business_id", "ce": "id", "fidelity": "lossy", "note": "A separate ID space. Explorium IDs do not carry over, so store the domain or the CompanyEnrich ID." },
      { "group": "Identity", "explorium": "name", "ce": "name", "fidelity": "same" },
      { "group": "Identity", "explorium": "domain", "ce": "domain", "fidelity": "same", "note": "Returned by Explorium fetch. Every CompanyEnrich company has one." },
      { "group": "Identity", "explorium": "website", "ce": "website", "fidelity": "transformed", "note": "CompanyEnrich returns a full URL, such as `https://acme.example`. Explorium examples use a bare domain." },
      { "group": "Identity", "explorium": "business_description", "ce": "description", "fidelity": "transformed", "note": "Written from different sources, so the text differs." },
      { "group": "Identity", "explorium": ["business_logo", "logo"], "ce": "logoUrl", "fidelity": "transformed" },
      { "group": "Identity", "explorium": "ticker", "ce": "financial.stockSymbol", "expand": "financial", "fidelity": "renamed" },
      { "group": "Size and industry", "explorium": "number_of_employees_range", "ce": "employees", "values": "companySize", "fidelity": "lossy", "note": "Calculated from CompanyEnrich employee data. `reportedEmployees` is only a search filter, for the range on the company's LinkedIn page." },
      { "group": "Size and industry", "explorium": "yearly_revenue_range", "ce": "revenue", "values": "revenue", "fidelity": "lossy" },
      { "group": "Size and industry", "explorium": "naics", "ce": "naicsCodes", "expand": "naicsCodes", "fidelity": "transformed", "note": "A list of codes instead of one code." },
      { "group": "Size and industry", "explorium": "naics_description", "ce": "industry", "fidelity": "lossy", "note": "CompanyEnrich `industry` is a NAICS industry title, such as `Software Publishers`." },
      { "group": "Size and industry", "explorium": "linkedin_industry_category", "ce": "industries", "fidelity": "lossy", "note": "A list from a different taxonomy." },
      { "group": "Size and industry", "explorium": ["sic_code", "sic_code_description"], "ce": null, "fidelity": "none" },
      { "group": "Location", "explorium": "country_name", "ce": "location.country.name", "fidelity": "transformed", "note": "Explorium lowercases names. CompanyEnrich also returns the ISO code in `location.country.code`." },
      { "group": "Location", "explorium": ["region_name", "region"], "ce": "location.state.name", "fidelity": "transformed" },
      { "group": "Location", "explorium": "city_name", "ce": "location.city.name", "fidelity": "transformed" },
      { "group": "Location", "explorium": "street", "ce": "location.address", "fidelity": "transformed" },
      { "group": "Location", "explorium": "zip_code", "ce": "location.postalCode", "fidelity": "renamed" },
      { "group": "Location", "explorium": ["locations_distribution", "number_of_locations"], "ce": null, "fidelity": "none" },
      { "group": "Social", "explorium": "linkedin_profile", "ce": "socials.linkedinUrl", "fidelity": "transformed", "note": "CompanyEnrich returns `https://www.linkedin.com/company/...`. Normalize both before comparing." },
      { "group": "Technographics", "explorium": ["full_tech_stack", "technologies_used_by_company_website"], "ce": "technologies", "expand": "technologies", "fidelity": "lossy", "note": "One flat list from different detection." },
      { "group": "Technographics", "explorium": ["full_nested_tech_stack", "technologies_categories", "categories_to_technologies_tree"], "ce": null, "fidelity": "none", "note": "No categories. Look up technologies with technology autocomplete." },
      { "group": "Technographics", "explorium": ["money_spent_on_website_technologies", "spend", "q_rank", "number_of_pages_on_sitemap", "ecommerce", "payment_options"], "ce": null, "fidelity": "none" },
      { "group": "Workforce", "explorium": "perc_<department>_roles", "ce": "workforce.departmentHeadcount", "expand": "workforce", "fidelity": "transformed", "note": "Counts per department instead of percentages. Divide by `workforce.observedEmployeeCount`. The departments differ; see the department values below." },
      { "group": "Workforce", "explorium": "change_in_<department>_roles", "ce": "workforce.history[].departmentHeadcount", "fidelity": "transformed", "note": "From `GET /v2/companies/workforce`. Compare two history points to get the change." },
      { "group": "Workforce", "explorium": "profiles_found_per_quarter", "ce": "workforce.observedEmployeeCount", "expand": "workforce", "fidelity": "lossy" },
      { "group": "Workforce", "explorium": "quarters", "ce": "workforce.history[].date", "fidelity": "transformed", "note": "One date per history point instead of quarter labels." },
      { "group": "Funding", "explorium": "known_funding_total_value", "ce": "financial.totalFunding", "expand": "financial", "fidelity": "renamed" },
      { "group": "Funding", "explorium": "last_funding_round_type", "ce": "financial.fundingStage", "expand": "financial", "fidelity": "transformed" },
      { "group": "Funding", "explorium": "last_funding_round_date", "ce": "financial.fundingDate", "expand": "financial", "fidelity": "transformed" },
      { "group": "Funding", "explorium": ["funding_rounds_info", "number_of_funding_rounds"], "ce": "financial.fundingRounds", "expand": "financial", "fidelity": "transformed", "note": "Each round has `type`, `date`, `amount`, and `investors`. Count the list for the number of rounds." },
      { "group": "Funding", "explorium": ["first_funding_round_type", "first_funding_round_date", "first_funding_round_value_usd", "last_funding_round_value_usd"], "ce": "financial.fundingRounds", "expand": "financial", "fidelity": "transformed", "note": "Sort the rounds by `date` and take the first or last." },
      { "group": "Funding", "explorium": "investors", "ce": "financial.fundingRounds[].investors", "expand": "financial", "fidelity": "transformed", "note": "Listed per round." },
